<%# app/views/onboarding/flow_4.html.erb %>
<%# Flow 4 (Figma node: 137:2207). One file: HTML+CSS+JS. %>

<%
  img_logo = "https://www.figma.com/api/mcp/asset/552f06ac-67f6-4d98-8d3a-641381587557"
  img_bars = "https://www.figma.com/api/mcp/asset/c1ec28f1-d038-4291-bae8-65bc7f89ca32"
  img_recipe = "https://www.figma.com/api/mcp/asset/acdb989d-52c4-4e1f-b560-af239fbb7153"
  img_percent = "https://www.figma.com/api/mcp/asset/7fa704fd-87ea-4567-957a-e13cd8501df4"
%>

<div class="k-flow k-flow4">
  <style>
    :root{
      --bg-secondary:#f9f3ea; --bg-primary:#fff9f0;
      --text-900:#25211b; --text-800:#46413b;
      --line-300:#e5dfd6;
      --btn-neutral-bg: rgba(41,35,24,0.05);
      --accent:#ff5d34;
      --blur:21px;
      --r:16px; --r-lg:28px;
      --max:840px; --pad:16px;
      --font: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Inter, Arial;
    }
    *{ box-sizing:border-box; }
    html,body{ height:100%; }
    body{ margin:0; background:var(--bg-secondary); color:var(--text-900); font-family:var(--font); }
    a{ text-decoration:none; color:inherit; }

    .k-flow{ min-height:100vh; display:flex; flex-direction:column; }
    .k-nav{ position:sticky; top:0; z-index:50; background:var(--bg-primary); border-bottom:1px solid var(--line-300); }
    .k-nav__top{ padding:8px var(--pad); display:flex; justify-content:space-between; align-items:center; gap:12px; }
    .k-logo{ height:21px; width:153px; display:block; }
    .k-iconbtn{
      width:40px; height:40px; border-radius:var(--r);
      border:0; background:var(--btn-neutral-bg);
      backdrop-filter: blur(var(--blur));
      display:grid; place-items:center;
      cursor:pointer;
      transition: transform .12s ease, filter .12s ease;
    }
    .k-iconbtn:hover{ filter:brightness(1.02); transform:translateY(-1px); }
    .k-iconbtn:active{ transform:translateY(0) scale(.98); }
    .k-iconbtn img{ width:20px; height:20px; display:block; }

    .k-layout{ width:100%; padding:24px var(--pad) 120px; display:flex; justify-content:center; }
    .k-content{ width:100%; max-width:var(--max); display:flex; flex-direction:column; gap:24px; }

    .k-grid{
      display:grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      width:100%;
    }
    .k-tile{
      display:flex; flex-direction:column; gap:8px;
      align-items:flex-start;
    }
    .k-tile__img{
      width:100%;
      aspect-ratio: 1/1;
      border-radius: var(--r-lg);
      overflow:hidden;
      background: var(--bg-primary);
      position:relative;
    }
    .k-tile__img img.recipe{
      position:absolute; left:50%; top:22px;
      width:150px; height:150px;
      transform:translateX(-50%);
      border-radius:999px;
      object-fit:cover;
      box-shadow: inset 0 0 14px 6px rgba(255,255,255,0.95);
    }
    .k-tile__name{
      margin:0;
      font-size:14.3px;
      line-height:1.5;
      letter-spacing:-0.2145px;
      font-weight:600;
      color: var(--text-800);
    }
    .k-tile__meta{
      display:flex; align-items:center; gap:8px;
      color: var(--accent);
      font-weight:700;
      letter-spacing:-0.16px;
    }
    .k-tile__meta img{ width:24px; height:24px; display:block; }
    .k-tile__meta span{ font-size:16px; }

    .k-checklist{ display:flex; flex-direction:column; gap:8px; }
    .k-check{
      display:flex;
      gap:12px;
      align-items:center;
      padding: 8px 0;
      border:0;
      background:transparent;
      cursor:pointer;
      text-align:left;
    }
    .k-box{
      width:24px; height:24px;
      border-radius:8px;
      border:2px solid #a39d95;
      display:grid; place-items:center;
      flex:0 0 auto;
    }
    .k-box svg{ width:18px; height:18px; opacity:0; }
    .k-check[aria-checked="true"] .k-box{
      border-color: var(--accent);
      background: rgba(255,93,52,0.10);
    }
    .k-check[aria-checked="true"] .k-box svg{ opacity:1; }
    .k-check__txt{
      margin:0;
      font-size:16px;
      line-height:1.5;
      letter-spacing:-0.16px;
      font-weight:700;
      color: var(--text-800);
    }

    .k-bottom{
      position:fixed; left:0; right:0; bottom:0;
      background: rgba(255,249,240,0.92);
      backdrop-filter: blur(var(--blur));
      border-top:1px solid var(--line-300);
      z-index:60;
    }
    .k-bottom__inner{
      max-width:var(--max); margin:0 auto; padding:16px var(--pad);
      display:flex; justify-content:space-between; align-items:center; gap:12px;
    }
    .k-btn{
      border:0; border-radius:var(--r);
      padding:16px;
      display:inline-flex; align-items:center; justify-content:center; gap:8px;
      cursor:pointer;
      font-weight:700; letter-spacing:-0.16px;
      transition: transform .12s ease, filter .12s ease;
      user-select:none;
    }
    .k-btn:hover{ filter:brightness(1.02); transform:translateY(-1px); }
    .k-btn:active{ transform:translateY(0) scale(.99); }
    .k-btn--dark{ background:#25211b; color:#fff9f0; }
    .k-btn--neutral{ background:var(--btn-neutral-bg); color:var(--text-800); padding:16px 32px; }
    .k-btn--accent{ background:var(--accent); color:#f1f1f1; }
    .k-ico{ width:24px; height:24px; display:block; }

    @media (max-width: 720px){
      .k-grid{ grid-template-columns: 1fr; }
      .k-tile__img img.recipe{ width:170px; height:170px; }
    }
  </style>

  <header class="k-nav" role="banner">
    <div class="k-nav__top">
      <img class="k-logo" src="<%= img_logo %>" alt="Солянка" />
      <button class="k-iconbtn" type="button" aria-label="Меню">
        <img src="<%= img_bars %>" alt="" />
      </button>
    </div>
  </header>

  <main class="k-layout" role="main">
    <div class="k-content">
      <section class="k-grid" aria-label="Выбранные рецепты">
        <% 2.times do %>
          <div class="k-tile">
            <div class="k-tile__img">
              <img class="recipe" src="<%= img_recipe %>" alt="" />
            </div>
            <p class="k-tile__name">Суп-пюре с грибами</p>
            <div class="k-tile__meta">
              <img src="<%= img_percent %>" alt="" />
              <span>60% есть</span>
            </div>
          </div>
        <% end %>
      </section>

      <section class="k-checklist" aria-label="Список продуктов" id="checklist">
        <% items = [
          "Грибы шампиньоны - 300 г",
          "Лук репчатый - 1 шт",
          "Картофель - 3-4 шт",
          "Сливки 33% - 250 мл",
          "Зелень петрушки - 1 стебель",
          "Сухарики чесночные - 1 шт",
          "Сухарики чесночные - 1 шт",
          "Сухарики чесночные - 1 шт",
          "Сухарики чесночные - 1 шт",
        ] %>

        <% items.each_with_index do |t,i| %>
          <button class="k-check" type="button" role="checkbox" aria-checked="<%= i==0 ? 'true' : 'false' %>" data-check>
            <span class="k-box" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M20 7L10 17l-4-4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <p class="k-check__txt"><%= t %></p>
          </button>
        <% end %>
      </section>
    </div>
  </main>

  <footer class="k-bottom" role="contentinfo">
    <div class="k-bottom__inner">
      <button class="k-btn k-btn--dark" type="button" aria-label="Назад">
        <svg class="k-ico" viewBox="0 0 24 24" fill="none">
          <path d="M11 6L5 12l6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M19 6l-6 6 6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <button class="k-btn k-btn--neutral" type="button" id="copyBtn">
        <svg class="k-ico" viewBox="0 0 24 24" fill="none">
          <path d="M8 8h10v12H8z" stroke="currentColor" stroke-width="2.2"/>
          <path d="M6 16H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
        Скопировать
      </button>

      <a class="k-btn k-btn--accent" href="#" aria-label="Готово">
        <svg class="k-ico" viewBox="0 0 24 24" fill="none">
          <path d="M20 12a8 8 0 1 1-4-6.93" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
          <path d="M20 6L11 15l-3-3" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </footer>

  <script>
    (function(){
      // чекбоксы
      const checks = Array.from(document.querySelectorAll('[data-check]'));
      checks.forEach(btn => {
        btn.addEventListener('click', () => {
          const on = btn.getAttribute('aria-checked') === 'true';
          btn.setAttribute('aria-checked', on ? 'false' : 'true');
        });
      });

      // копирование списка в буфер (да, людям это нравится)
      const copyBtn = document.getElementById('copyBtn');
      copyBtn?.addEventListener('click', async () => {
        const lines = checks.map(b => {
          const text = b.querySelector('.k-check__txt')?.textContent?.trim() || '';
          const checked = b.getAttribute('aria-checked') === 'true';
          return (checked ? "✓ " : "• ") + text;
        }).join("\n");

        try{
          await navigator.clipboard.writeText(lines);
          copyBtn.textContent = "Скопировано";
          setTimeout(() => copyBtn.textContent = "Скопировать", 1200);
        }catch(e){
          // ну вдруг браузер решил “не дам”
          alert("Не получилось скопировать. Выдели и скопируй вручную.");
        }
      });
    })();
  </script>
</div>
