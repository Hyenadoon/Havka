<h1>Список задач</h1>

<%= link_to "Новая задача", new_task_path %>

<ul>
  <% @tasks.each do |task| %>
    <li>
      <strong><%= task.title %></strong>
      <% if task.done %>
        (выполнена)
      <% else %>
        (не выполнена)
      <% end %>
      <%= link_to "Показать", task_path(task) %> |
      <%= link_to "Редактировать", edit_task_path(task) %> |
      <%= link_to "Удалить", task_path(task), method: :delete, data: { confirm: "Ты уверен?" } %>
    </li>
  <% end %>
</ul>