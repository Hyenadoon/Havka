<%# app/views/home/index.html.erb %>
<%# Home (Figma node: 96:1103). One file: HTML+CSS+JS. %>

<%
  # Assets (из Figma MCP)
  img_recipe = "https://www.figma.com/api/mcp/asset/f32597ea-dcdc-4730-ab4e-1e87897f7ddb"
  img_collection = "https://www.figma.com/api/mcp/asset/1b6e1a13-81b8-4ee1-a1b5-4325f37bf023"
  img_logo = "https://www.figma.com/api/mcp/asset/552f06ac-67f6-4d98-8d3a-641381587557"
  img_bars = "https://www.figma.com/api/mcp/asset/c1ec28f1-d038-4291-bae8-65bc7f89ca32"
  img_icon_board = "https://www.figma.com/api/mcp/asset/ff9dffc7-b770-484a-a022-9cf60d701728"
  img_icon_main = "https://www.figma.com/api/mcp/asset/9e096cfb-676c-4d7f-ba5f-6ced3f81a1f7"
  img_icon_planner = "https://www.figma.com/api/mcp/asset/b695b02b-93c6-4412-bcc3-74d83c9364c9"
  img_icon_search = "https://www.figma.com/api/mcp/asset/ec060d25-fcd5-4c6c-bfec-26b2a3dd66b3"

  user_name = (defined?(current_user) && current_user&.respond_to?(:name) ? current_user.name : nil)

  collections = [
    { title_html: "<span class='k-home__em'>C макаронами</span>", count: "15 рецептов" },
    { title_html: "<span class='k-home__em'>C курицей</span>", count: "12 рецептов" }
  ]

  popular = Array.new(5) { { title: "Суп-пюре с грибами", img: img_recipe } }

  # Сортировка по приему пищи (демо)
  meals = %w[Завтрак Обед Полдник Ужин]

  # Демо карточки в списке
  feed = [
    { title: "Суп-пюре с грибами", price: "~ 150р", time: "15 мин", portions: "4 порции", img: img_recipe },
    { title: "Суп-пюре с грибами", price: "~ 150р", time: "15 мин", portions: "4 порции", img: img_recipe }
  ]
%>

<div class="k-home">
  <style>
    :root{
      --bg-secondary:#f9f3ea;
      --bg-primary:#fff9f0;
      --bg-input:#f4ede4;

      --text-900:#25211b;
      --text-800:#46413b;
      --text-800-61: rgba(41,35,24,0.61);
      --text-muted: rgba(41,35,24,0.22);

      --line-300:#e5dfd6;
      --line-soft: rgba(41,35,24,0.07);

      --btn-neutral-bg: rgba(41,35,24,0.05);
      --btn-neutral-text:#46413b;

      --accent:#ff5d34;
      --btn-accent-bg: rgba(255,93,52,0.12);

      --tag-bg: rgba(41,35,24,0.05);
      --tag-text: rgba(41,35,24,0.5);

      --r-sm: 8px;
      --r: 16px;
      --r-pill: 120px;

      --max: 840px;
      --pad: 16px;
      --blur: 21px;

      --shadow: 0 18px 50px rgba(0,0,0,.00);
      --shadow2: 0 10px 24px rgba(0,0,0,.00);

      --font: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Inter, Arial;
    }
    a {
       text-decoration: none;
    }

    *{ box-sizing:border-box; }
    html,body{ height:100%; }
    body{ margin:0; background: var(--bg-secondary); color: var(--text-900); font-family: var(--font); }

    .k-home{ min-height: 100vh; display:flex; flex-direction:column; }

    /* sticky navigation (как в фигме) */
    .k-home__nav{
      position: sticky;
      top: 0;
      z-index: 30;
      display:flex;
      flex-direction:column;
      width:100%;
      overflow:hidden;
    }

    .k-home__nav-top{
      background: var(--bg-primary);
      border-bottom: 1px solid var(--line-300);
      padding: 8px var(--pad);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap: 12px;
    }

    .k-home__logo{
      height: 21px;
      width: 153px;
      display:block;
    }

    .k-home__iconbtn{
      width: 40px;
      height: 40px;
      border-radius: var(--r);
      border: 0;
      background: var(--btn-neutral-bg);
      backdrop-filter: blur(var(--blur));
      display:grid;
      place-items:center;
      cursor:pointer;
      transition: transform .12s ease, filter .12s ease;
    }
    .k-home__iconbtn:hover{ filter: brightness(1.02); transform: translateY(-1px); }
    .k-home__iconbtn:active{ transform: translateY(0) scale(.98); }
    .k-home__iconbtn img{ width:20px; height:20px; display:block; }

    .k-home__nav-tabs{
      background: var(--bg-primary);
      height: 64px;
      position:relative;
    }

    .k-home__tabs{
      position:absolute;
      left: 21px;
      top: 50%;
      transform: translateY(-50%);
      display:flex;
      gap: 8px;
      align-items:center;
      flex-wrap:wrap;
    }

    .k-home__tab{
      display:inline-flex;
      gap: 12px;
      padding: 12px 24px;
      border-radius: var(--r);
      background: var(--btn-neutral-bg);
      backdrop-filter: blur(var(--blur));
      color: var(--btn-neutral-text);
      font-weight: 700;
      letter-spacing: -0.16px;
      text-decoration:none;
      border: 0;
      cursor:pointer;
      transition: transform .12s ease, filter .12s ease;
    }
    .k-home__tab:hover{ filter: brightness(1.02); transform: translateY(-1px); }
    .k-home__tab:active{ transform: translateY(0) scale(.99); }
    .k-home__tab img{ width:24px; height:24px; display:block; }

    .k-home__tab--active{
      background: var(--btn-accent-bg);
      color: var(--accent);
    }
    .k-home__tab--active img{ filter: none; }

    /* layout */
    .k-home__layout{
      width:100%;
      padding: 40px var(--pad);
      display:flex;
      justify-content:center;
      overflow:hidden;
    }
    .k-home__content{
      width:100%;
      max-width: var(--max);
      display:flex;
      flex-direction:column;
      gap: 40px;
    }

    .k-home__h1{
      margin:0;
      font-size: 23px;
      line-height: 1.3;
      letter-spacing: -0.576px;
      color: #514242; /* как в фигме */
      font-weight: 600;
    }

    /* search input */
    .k-home__search{
      height: 48px;
      border-radius: var(--r-sm);
      background: var(--bg-input);
      display:flex;
      align-items:center;
      gap: 10px;
      padding: 12px 16px;
    }
    .k-home__search img{ width:24px; height:24px; display:block; opacity:.95; }
    .k-home__search input{
      width:100%;
      border:0;
      outline:none;
      background:transparent;
      font-size: 16px;
      letter-spacing: -0.16px;
      color: var(--text-800);
    }
    .k-home__search input::placeholder{ color: var(--text-muted); }

    /* blocks titles */
    .k-home__block-title{
      margin:0;
      font-size: 16px;
      line-height: 1.5;
      letter-spacing: -0.16px;
      font-weight: 600;
      color: var(--text-800-61);
    }

    /* Collections */
    .k-home__collections{
      display:flex;
      flex-direction:column;
      gap: 8px;
    }
    .k-home__collections-row{
      padding: 8px 0;
      display:flex;
      gap: 8px;
      overflow:auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    .k-home__collections-row::-webkit-scrollbar{ height: 10px; }
    .k-home__collections-row::-webkit-scrollbar-thumb{ background: rgba(41,35,24,0.12); border-radius: 999px; }

    .k-home__collection{
      width: 299px;
      min-width: 299px;
      height: 160px;
      border-radius: var(--r);
      border: 2px solid var(--line-soft);
      position:relative;
      overflow:hidden;
      padding: 12px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      scroll-snap-align: start;
      box-shadow: var(--shadow2);
    }
    .k-home__collection::before{
      content:"";
      position:absolute; inset:0;
      background: var(--bg-primary);
      z-index:0;
    }
    .k-home__collection img{
      position:absolute; inset:0;
      width:100%; height:100%;
      object-fit: cover;
      object-position: 50% 50%;
      z-index:1;
    }
    .k-home__collection > *{ position:relative; z-index:2; }
    .k-home__collection-title{
      margin:0;
      font-size: 23px;
      line-height: 1.3;
      letter-spacing: -0.576px;
      color: var(--text-900);
      font-weight: 600;
    }
    .k-home__collection-sub{
      margin:0;
      font-size: 14.3px;
      line-height: 1.5;
      letter-spacing: -0.2145px;
      color: var(--text-900);
      font-weight: 600;
    }
    .k-home__em{ font-weight: 800; }

    /* Popular horizontal recipes */
    .k-home__popular{
      display:flex;
      flex-direction:column;
      gap: 8px;
    }
    .k-home__popular-row{
      height: 174px;
      position:relative;
      overflow:auto;
      -webkit-overflow-scrolling: touch;
    }
    .k-home__popular-row::-webkit-scrollbar{ height: 10px; }
    .k-home__popular-row::-webkit-scrollbar-thumb{ background: rgba(41,35,24,0.12); border-radius: 999px; }

    .k-home__popular-inner{
      position:absolute;
      left:0; top:0;
      display:flex;
      gap: 12px;
      align-items:flex-start;
      padding-bottom: 8px;
    }

    .k-home__recipe-small{
      display:flex;
      flex-direction:column;
      gap: 8px;
      width: 124px;
      min-width: 124px;
    }
    .k-home__recipe-small-img{
      width: 124px;
      height: 124px;
      border-radius: var(--r);
      overflow:hidden;
      background: #fff9f0;
      position:relative;
      box-shadow: var(--shadow2);
    }
    .k-home__recipe-small-img img{
      width:100%; height:100%;
      object-fit: cover;
      object-position: 50% 50%;
      display:block;
    }
    .k-home__recipe-small-title{
      margin:0;
      font-size: 14.3px;
      line-height: 1.5;
      letter-spacing: -0.2145px;
      color: var(--text-800);
      font-weight: 600;
    }

    /* Sorting */
    .k-home__sorting{
      display:flex;
      flex-direction:column;
      gap: 16px;
    }
    .k-home__filters{
      padding: 8px 0;
      display:flex;
      gap: 8px;
      overflow:auto;
      -webkit-overflow-scrolling: touch;
    }
    .k-home__filters::-webkit-scrollbar{ height: 10px; }
    .k-home__filters::-webkit-scrollbar-thumb{ background: rgba(41,35,24,0.12); border-radius: 999px; }

    .k-home__filter{
      border:0;
      background: rgba(41,35,24,0.05);
      color: var(--text-800);
      padding: 8px 16px;
      border-radius: var(--r-pill);
      font-size: 16px;
      letter-spacing: -0.16px;
      font-weight: 600;
      cursor:pointer;
      white-space:nowrap;
      transition: transform .12s ease, filter .12s ease;
    }
    .k-home__filter:hover{ filter: brightness(1.02); transform: translateY(-1px); }
    .k-home__filter:active{ transform: translateY(0) scale(.99); }
    .k-home__filter[aria-selected="true"]{
      background: var(--btn-accent-bg);
      color: var(--accent);
    }

    /* Medium recipe cards list */
    .k-home__feed{
      display:flex;
      flex-direction:column;
      gap: 16px;
    }
    .k-home__recipe-medium{
      display:flex;
      gap: 8px;
      align-items:flex-start;
      text-decoration:none;
      color: inherit;
    }
    .k-home__recipe-medium-img{
      width: 164px;
      min-width: 164px;
      height: 148px;
      border-radius: var(--r);
      overflow:hidden;
      background: #fff9f0;
      box-shadow: var(--shadow2);
      position:relative;
    }
    .k-home__recipe-medium-img img{
      width:100%; height:100%;
      object-fit: cover;
      object-position: 50% 50%;
      display:block;
    }
    .k-home__recipe-medium-info{
      display:flex;
      flex-direction:column;
      gap: 16px;
      padding-top: 2px;
    }
    .k-home__recipe-medium-titlewrap{
      display:flex;
      flex-direction:column;
      gap: 4px;
    }
    .k-home__recipe-medium-title{
      margin:0;
      font-size: 16px;
      line-height: 1.5;
      letter-spacing: -0.16px;
      color: var(--text-800);
      font-weight: 700;
    }
    .k-home__recipe-medium-price{
      margin:0;
      height: 24px;
      font-size: 16px;
      line-height: 1.5;
      letter-spacing: -0.16px;
      color: var(--accent);
      font-weight: 700;
    }

    .k-home__tags{
      display:flex;
      gap: 4px;
      align-items:center;
      flex-wrap:wrap;
    }
    .k-home__tag{
      height: 32px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap: 4px;
      padding: 6px 8px;
      border-radius: 48px;
      background: var(--tag-bg);
      backdrop-filter: blur(var(--blur));
      color: var(--tag-text);
      font-size: 14.3px;
      letter-spacing: -0.2145px;
      font-weight: 600;
      white-space:nowrap;
    }
    .k-home__tag svg, .k-home__tag img{
      width:20px; height:20px; display:block;
      opacity:.9;
    }

    /* Show more */
    .k-home__more-wrap{
      display:flex;
      justify-content:center;
      overflow:hidden;
    }
    .k-home__more{
      height: 48px;
      width: 100%;
      max-width: 300px;
      border-radius: var(--r);
      border:0;
      background: var(--btn-neutral-bg);
      backdrop-filter: blur(var(--blur));
      color: var(--text-800);
      font-size: 16px;
      letter-spacing: -0.16px;
      font-weight: 700;
      cursor:pointer;
      transition: transform .12s ease, filter .12s ease;
    }
    .k-home__more:hover{ filter: brightness(1.02); transform: translateY(-1px); }
    .k-home__more:active{ transform: translateY(0) scale(.99); }

    /* Responsive */
    @media (max-width: 720px){
      .k-home__tabs{ left: 16px; right: 16px; }
      .k-home__tab{ padding: 12px 16px; }
      .k-home__content{ gap: 28px; }
      .k-home__layout{ padding: 28px 16px; }
      .k-home__recipe-medium{ flex-direction:column; }
      .k-home__recipe-medium-img{ width:100%; min-width: 0; height: 180px; }
    }
  </style>

  <header class="k-home__nav" role="banner">
    <div class="k-home__nav-top">
      <img class="k-home__logo" src="<%= img_logo %>" alt="Солянка" />
      <button class="k-home__iconbtn" type="button" aria-label="Меню">
        <img src="<%= img_bars %>" alt="" />
      </button>
    </div>

    <div class="k-home__nav-tabs">
      <div class="k-home__tabs" role="navigation" aria-label="Навигация">
        <%# Подставь свои пути %>
        <a class="k-home__tab" href="<%= defined?(recipes_path) ? recipes_path : '#' %>">
          <img src="<%= img_icon_board %>" alt="" />
          Подобрать рецепт
        </a>

        <a class="k-home__tab k-home__tab--active" href="<%= defined?(root_path) ? root_path : '#' %>" aria-current="page">
          <img src="<%= img_icon_main %>" alt="" />
          Главная
        </a>

        <a class="k-home__tab" href="<%= defined?(planner_path) ? planner_path : '#' %>">
          <img src="<%= img_icon_planner %>" alt="" />
          Планёр
        </a>
      </div>
    </div>
  </header>

  <main class="k-home__layout" role="main">
    <div class="k-home__content">
      <h1 class="k-home__h1"><%= ("Самое вкусно уже здесь" + (user_name ? ", #{h(user_name)}" : "") + " ").strip %></h1>

      <form class="k-home__search" action="<%= defined?(search_path) ? search_path : '#' %>" method="get" role="search">
        <img src="<%= img_icon_search %>" alt="" />
        <input name="q" value="<%= h(params[:q].to_s) %>" placeholder="Болоньезе..." autocomplete="off" />
      </form>

      <section class="k-home__collections" aria-label="Подборки">
        <p class="k-home__block-title">Подборки</p>
        <div class="k-home__collections-row">
          <% collections.each do |c| %>
            <a class="k-home__collection" href="<%= defined?(collections_path) ? collections_path : '#' %>">
              <img src="<%= img_collection %>" alt="" />
              <p class="k-home__collection-title"><%= c[:title_html].html_safe %></p>
              <p class="k-home__collection-sub"><%= c[:count] %></p>
            </a>
          <% end %>
        </div>
      </section>

      <section class="k-home__popular" aria-label="Чаще всего готовят">
        <p class="k-home__block-title">Чаще всего готовят</p>
        <div class="k-home__popular-row">
          <div class="k-home__popular-inner">
            <% popular.each do |r| %>
              <a class="k-home__recipe-small" href="<%= defined?(recipe_path) ? recipe_path(1) : '#' %>">
                <div class="k-home__recipe-small-img">
                  <img src="<%= r[:img] %>" alt="" />
                </div>
                <p class="k-home__recipe-small-title"><%= r[:title] %></p>
              </a>
            <% end %>
          </div>
        </div>
      </section>

      <section class="k-home__sorting" aria-label="Сортировка рецептов">
        <div>
          <p class="k-home__block-title">Прием пищи</p>
          <div class="k-home__filters" role="tablist" aria-label="Фильтр по приему пищи">
            <% meals.each_with_index do |m, i| %>
              <button
                class="k-home__filter"
                type="button"
                role="tab"
                aria-selected="<%= i == 0 ? "true" : "false" %>"
                data-meal="<%= m %>"><%= m %></button>
            <% end %>
          </div>
        </div>

        <div class="k-home__feed" id="kHomeFeed">
          <% feed.each do |r| %>
            <a class="k-home__recipe-medium" href="<%= defined?(recipe_path) ? recipe_path(1) : '#' %>">
              <div class="k-home__recipe-medium-img">
                <img src="<%= r[:img] %>" alt="" />
              </div>

              <div class="k-home__recipe-medium-info">
                <div class="k-home__recipe-medium-titlewrap">
                  <p class="k-home__recipe-medium-title"><%= r[:title] %></p>
                  <p class="k-home__recipe-medium-price"><%= r[:price] %></p>
                </div>

                <div class="k-home__tags">
                  <span class="k-home__tag" title="Время">
                    <%# иконку времени в фигме тянули отдельным svg asset; тут проще нейтральный кружок %>
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <circle cx="12" cy="12" r="9" stroke="rgba(41,35,24,1)" stroke-width="1.6" opacity=".75"></circle>
                      <path d="M12 7v5l3 2" stroke="rgba(41,35,24,1)" stroke-width="1.6" stroke-linecap="round" opacity=".75"></path>
                    </svg>
                    <%= r[:time] %>
                  </span>

                  <span class="k-home__tag"><%= r[:portions] %></span>
                </div>
              </div>
            </a>
          <% end %>
        </div>

        <div class="k-home__more-wrap">
          <button class="k-home__more" type="button" id="kHomeMore">Показать ещё 5</button>
        </div>
      </section>
    </div>
  </main>

  <script>
    // 1) Tabs: делаем выбранный фильтр активным
    (function(){
      const tabs = Array.from(document.querySelectorAll(".k-home__filter"));
      tabs.forEach(btn => {
        btn.addEventListener("click", () => {
          tabs.forEach(x => x.setAttribute("aria-selected", "false"));
          btn.setAttribute("aria-selected", "true");

          // Тут в проде ты дергаешь Turbo/Stimulus/Fetch и обновляешь ленту.
          // Пока оставляем как UI-стейт.
        });
      });

      // 2) “Показать еще”: мок, чтобы кнопка ощущалась живой
      const more = document.getElementById("kHomeMore");
      const feed = document.getElementById("kHomeFeed");
      if (more && feed) {
        more.addEventListener("click", () => {
          more.disabled = true;
          more.textContent = "Загружаем...";
          setTimeout(() => {
            // Дублируем пару карточек как демо.
            const nodes = Array.from(feed.querySelectorAll(".k-home__recipe-medium")).slice(0, 1);
            nodes.forEach(n => feed.appendChild(n.cloneNode(true)));
            more.disabled = false;
            more.textContent = "Показать ещё 5";
          }, 450);
        });
      }
    })();
  </script>
</div>
