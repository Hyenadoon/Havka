<%# app/views/static/styleguide.html.erb %>
<%# Styleguide (Figma node: 280:2475). One file: HTML+CSS. %>

<%
  # Навбар (как в остальных экранах)
  img_logo = "https://www.figma.com/api/mcp/asset/552f06ac-67f6-4d98-8d3a-641381587557"
  img_bars = "https://www.figma.com/api/mcp/asset/c1ec28f1-d038-4291-bae8-65bc7f89ca32"

  # Иконки табов из Styleguide фрейма (вытянуты MCP)
  img_tab_board = "https://www.figma.com/api/mcp/asset/fc8a9dd5-2533-45f0-b50a-79c709aebdbd"
  img_tab_home  = "https://www.figma.com/api/mcp/asset/09bf5047-4dd1-4f25-92fc-1844d9f99e21"
  img_tab_plan  = "https://www.figma.com/api/mcp/asset/b1367703-69ca-4e66-bd0e-0cf86340b432"

  # Контентные картинки стайлгайда (вытянуты MCP)
  img_hero          = "https://www.figma.com/api/mcp/asset/254e3063-3557-44b1-9074-81420032aec4"
  img_plate         = "https://www.figma.com/api/mcp/asset/87936437-da07-435f-97e9-5a8c6e82b351"
  img_ingredients    = "https://www.figma.com/api/mcp/asset/4a0c42cb-487b-4556-a2e0-c65663f0b28a"
  img_dish          = "https://www.figma.com/api/mcp/asset/7c53d9e7-6faf-4a09-b2dd-1f8667c1686e"

  img_state_ing     = "https://www.figma.com/api/mcp/asset/75cc4b2a-ed93-447a-a2e1-a2378c649998"
  img_state_process = "https://www.figma.com/api/mcp/asset/7f641301-d4c4-4757-a0c7-dc70ff4767b6"
  img_state_dish    = "https://www.figma.com/api/mcp/asset/2e57f49c-00f4-4d7a-829b-abb6fb70225a"

  img_palette        = "https://www.figma.com/api/mcp/asset/098f976b-0458-4b9d-98e2-e4601574695c"
  img_black_rule     = "https://www.figma.com/api/mcp/asset/156ef707-a433-4ccf-9314-18af35738ff9"

  img_logo_main      = "https://www.figma.com/api/mcp/asset/e2f95050-cd93-4d8d-9495-cb3e32e0051b"
  img_logo_small_1   = "https://www.figma.com/api/mcp/asset/2f67ca18-3bc3-417b-90ef-a36c29590b33"
  img_logo_small_2   = "https://www.figma.com/api/mcp/asset/c72ced8d-506a-43b8-b2ab-d261ea5f00c9"

  img_font_1         = "https://www.figma.com/api/mcp/asset/0a4ca85e-f0b0-4b3e-ad57-7b87b6654208"
  img_font_2         = "https://www.figma.com/api/mcp/asset/d656f120-ff1a-4d25-a4a8-2be3646a88e4"

  img_grid           = "https://www.figma.com/api/mcp/asset/9986fd1d-f53e-4bfb-bcbb-3ca369d6d32a"

  img_extra_1        = "https://www.figma.com/api/mcp/asset/819725dd-00fe-4f55-9c26-e4b7a629fdc9"
  img_extra_2        = "https://www.figma.com/api/mcp/asset/88ed754d-a367-42e8-8703-212ffd12c1ea"
  img_extra_3        = "https://www.figma.com/api/mcp/asset/6899b78c-1ece-4051-b688-a96ec78d183f"
%>

<div class="k-styleguide">
  <style>
    :root{
      --bg-secondary:#f9f3ea;
      --bg-primary:#fff9f0;
      --bg-input:#f4ede4;

      --text-900:#25211b;
      --text-800:#46413b;
      --text-800-61: rgba(41,35,24,0.61);
      --text-800-80: rgba(41,35,24,0.8);
      --text-muted: rgba(41,35,24,0.22);

      --line-300:#e5dfd6;
      --line-soft: rgba(41,35,24,0.07);

      --btn-neutral-bg: rgba(41,35,24,0.05);
      --btn-neutral-text:#46413b;

      --accent:#ff5d34;
      --accent-soft: rgba(255,93,52,0.12);

      --r-sm: 8px;
      --r: 16px;
      --r-md: 24px;
      --r-lg: 32px;

      --max: 840px;
      --pad: 16px;
      --blur: 21px;

      --shadow2: 0 10px 24px rgba(0,0,0,.05);

      --font: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Inter, Arial;
    }

    *{ box-sizing:border-box; }
    html,body{ height:100%; }
    body{ margin:0; background: var(--bg-secondary); color: var(--text-900); font-family: var(--font); }
    a{ text-decoration:none; color:inherit; }

    .k-styleguide{ min-height: 100vh; display:flex; flex-direction:column; }

    /* navigation (как в остальных экранах) */
    .k-nav{
      position: sticky;
      top: 0;
      z-index: 60;
      background: var(--bg-primary);
      border-bottom: 1px solid var(--line-300);
    }
    .k-nav__top{
      padding: 8px var(--pad);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap: 12px;
    }
    .k-logo{ height:21px; width:153px; display:block; }

    .k-iconbtn{
      width: 40px; height: 40px;
      border-radius: var(--r);
      border: 0;
      background: var(--btn-neutral-bg);
      backdrop-filter: blur(var(--blur));
      display:grid;
      place-items:center;
      cursor:pointer;
      transition: transform .12s ease, filter .12s ease;
    }
    .k-iconbtn:hover{ filter: brightness(1.02); transform: translateY(-1px); }
    .k-iconbtn:active{ transform: translateY(0) scale(.98); }
    .k-iconbtn img{ width:20px; height:20px; display:block; }

    .k-tabs-wrap{ height: 64px; position:relative; background: var(--bg-primary); }
    .k-tabs{
      position:absolute;
      left: 21px;
      top: 50%;
      transform: translateY(-50%);
      display:flex;
      gap: 8px;
      align-items:center;
      flex-wrap:wrap;
    }
    .k-tab{
      display:inline-flex;
      gap: 8px;
      padding: 12px 24px;
      border-radius: var(--r);
      background: var(--btn-neutral-bg);
      backdrop-filter: blur(var(--blur));
      color: var(--text-800);
      font-weight: 700;
      letter-spacing: -0.16px;
      transition: transform .12s ease, filter .12s ease;
    }
    .k-tab:hover{ filter: brightness(1.02); transform: translateY(-1px); }
    .k-tab:active{ transform: translateY(0) scale(.99); }
    .k-tab img{ width:24px; height:24px; display:block; }
    .k-tab--active{ background: var(--accent-soft); color: var(--accent); }

    /* layout */
    .k-layout{
      width:100%;
      padding: 40px var(--pad);
      display:flex;
      justify-content:center;
    }
    .k-content{
      max-width: var(--max);
      display:flex;
      flex-direction:column;
      gap: 40px;
    }

    .k-section{ display:flex; flex-direction:column; gap: 24px; }
    .k-h2{
      margin:0;
      font-size: 23.04px;
      line-height: 1.3;
      letter-spacing: -0.576px;
      color: #514242;
      font-weight: 600;
    }
    .k-p{
      margin:0;
      font-size: 16px;
      line-height: 1.5;
      letter-spacing: -0.16px;
      color: var(--text-800-80);
      font-weight: 500;
    }

    .k-img{
      width:100%;
      border-radius: var(--r);
      overflow:hidden;
      background: var(--bg-primary);
      box-shadow: var(--shadow2);
    }
    .k-img img{
      width:100%;
      height:auto;
      display:block;
      object-fit: cover;
      object-position: 50% 50%;
    }

    .k-quote{
      border-left: 2px solid #534d42;
      padding-left: 18px;
      display:flex;
      flex-direction:column;
      gap: 6px;
    }
    .k-quote p, .k-quote li{
      margin:0;
      font-size: 16px;
      line-height: 1.5;
      letter-spacing: -0.16px;
      color: var(--text-800-80);
      font-weight: 500;
    }
    .k-quote ul{ margin:0; padding-left: 22px; }
    .k-quote li{ margin: 0; }

    .k-grid2{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      width:100%;
    }

    /* фикс под “мобильный стильгайд” шириной ~361px: на десктопе читаемо, на мобиле 1 колонка */
    .k-narrow{
      max-width: 361px;
    }

    .k-caption{
      margin:0;
      font-size: 16px;
      line-height: 1.5;
      letter-spacing: -0.16px;
      color: var(--text-800-80);
      font-weight: 500;
    }

    @media (max-width: 720px){
      .k-layout{ padding: 28px 16px; }
      .k-tabs{ left: 16px; right: 16px; }
      .k-tab{ padding: 12px 16px; }
      .k-grid2{ grid-template-columns: 1fr; }
      .k-narrow{ max-width: 100%; }
    }
  </style>

  <header class="k-nav" role="banner">
    <div class="k-nav__top">
      <img class="k-logo" src="<%= img_logo %>" alt="Солянка" />
      <button class="k-iconbtn" type="button" aria-label="Меню">
        <img src="<%= img_bars %>" alt="" />
      </button>
    </div>

    <div class="k-tabs-wrap">
      <nav class="k-tabs" aria-label="Навигация">
        <a class="k-tab" href="<%= defined?(recipes_path) ? recipes_path : '#' %>">
          <img src="<%= img_tab_board %>" alt="" />
          Подобрать рецепт
        </a>

        <a class="k-tab k-tab--active" href="<%= defined?(root_path) ? root_path : '#' %>" aria-current="page">
          <img src="<%= img_tab_home %>" alt="" />
          Главная
        </a>

        <a class="k-tab" href="<%= defined?(planner_path) ? planner_path : '#' %>">
          <img src="<%= img_tab_plan %>" alt="" />
          Планёр
        </a>
      </nav>
    </div>
  </header>

  <main class="k-layout" role="main">
    <div class="k-content">

      <section class="k-section k-narrow" aria-label="Hero">
        <div class="k-img">
          <img src="<%= img_hero %>" alt="Styleguide hero" />
        </div>
      </section>

      <section class="k-section" aria-label="Бренд">
        <h2 class="k-h2">Бренд</h2>
        <div class="k-section" style="gap:16px">
          <p class="k-p">Круг = блюдо / порядок / результат</p>
          <p class="k-p">Форма внутри круга = ингредиенты / хаос / процесс</p>
          <div class="k-quote">
            <p>Хаос не по всему макету, а локально заключён в рамки.</p>
          </div>
        </div>
      </section>

      <section class="k-section" aria-label="Основной принцип">
        <h2 class="k-h2">основной принцип</h2>
        <div class="k-section" style="gap:16px">
          <p class="k-p">Круг = блюдо / порядок / результат</p>
          <p class="k-p">Форма внутри круга = ингредиенты / хаос / процесс</p>
          <div class="k-quote">
            <p>Хаос не по всему макету, а локально заключён в рамки.</p>
          </div>
        </div>
      </section>

      <section class="k-section" aria-label="Графический элемент">
        <h2 class="k-h2">графический элемент</h2>

        <div class="k-section k-narrow">
          <div class="k-img"><img src="<%= img_plate %>" alt="Круг-тарелка" /></div>
          <p class="k-caption">Круг-тарелка</p>
          <div class="k-quote">
            <p>Образ системы, решения проблемы пользователя. В него заключается следующий элемент графики, ингридиенты</p>
          </div>
        </div>

        <div class="k-section k-narrow">
          <div class="k-img"><img src="<%= img_ingredients %>" alt="Ингридиенты" /></div>
          <p class="k-caption">Ингридиенты</p>
          <div class="k-quote">
            <p>неправильные сегменты</p>
            <p>пересечения</p>
            <p>разные масштабы</p>
            <p>ощущение движения</p>
          </div>
        </div>

        <div class="k-section k-narrow">
          <div class="k-img"><img src="<%= img_dish %>" alt="Блюдо" /></div>
          <p class="k-caption">Блюдо</p>
          <div class="k-quote">
            <p>Тарелка удерживает хаос внутри себя,</p>
            <p>что отражает основную идею сервиса,</p>
            <p>из хаоса в системность</p>
          </div>

          <p class="k-caption" style="margin-top:8px;">Правила</p>
          <div class="k-quote">
            <ul>
              <li>формы не касаются края идеально</li>
              <li>нет симметрии</li>
              <li>нет повторяющихся паттернов</li>
              <li>максимум 4 формы внутри одного круга</li>
              <li>одинаковый размер на носителе</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="k-section" aria-label="Состояния системы">
        <h2 class="k-h2">Три основных состояния системы</h2>

        <div class="k-section k-narrow">
          <div class="k-img"><img src="<%= img_state_ing %>" alt="Ингридиенты" /></div>
          <p class="k-caption">Ингридиенты</p>
        </div>

        <div class="k-section k-narrow">
          <div class="k-img"><img src="<%= img_state_process %>" alt="Процесс приготовления" /></div>
          <p class="k-caption">Процесс приготовления</p>
        </div>

        <div class="k-section k-narrow">
          <div class="k-img"><img src="<%= img_state_dish %>" alt="Блюдо" /></div>
          <p class="k-caption">Блюдо</p>
        </div>
      </section>

      <section class="k-section" aria-label="Цветовая схема">
        <h2 class="k-h2">цветовая схема</h2>
        <p class="k-p k-narrow">Нейтральные цвета — отражение системности</p>
        <p class="k-p k-narrow">Яркие оттенки — категории продуктов, которые и образуют блюда</p>

        <div class="k-img k-narrow" style="border-radius:0; box-shadow:none; background:transparent; overflow:visible;">
          <img src="<%= img_palette %>" alt="Палитра" style="border-radius:0; box-shadow:none;" />
        </div>

        <div class="k-quote k-narrow">
          <p>Яркие цвета могут смешиваться<br/>Белый комбинируется с яркими</p>
        </div>

        <div class="k-section k-narrow">
          <div class="k-img"><img src="<%= img_black_rule %>" alt="Правило черного" /></div>
        </div>

        <div class="k-quote k-narrow">
          <p>Черный нельзя смешивать с другими цветами кроме белого</p>
        </div>
      </section>

      <section class="k-section" aria-label="Логотип">
        <h2 class="k-h2">Логотип</h2>

        <div class="k-section k-narrow" style="gap:8px">
          <div class="k-img"><img src="<%= img_logo_main %>" alt="Логотип основной" /></div>

          <div class="k-grid2">
            <div class="k-img"><img src="<%= img_logo_small_1 %>" alt="Логотип вариант 1" /></div>
            <div class="k-img"><img src="<%= img_logo_small_2 %>" alt="Логотип вариант 2" /></div>
          </div>
        </div>

        <div class="k-quote k-narrow">
          <p>Показываем движение в логотипе, тарелка — наш основной символ. Она и является буквой О</p>
        </div>
      </section>

      <section class="k-section" aria-label="Акцентный шрифт">
        <h2 class="k-h2">акцедентный шрифт</h2>

        <div class="k-section k-narrow" style="gap:16px">
          <div class="k-img"><img src="<%= img_font_1 %>" alt="Tovar пример 1" /></div>
          <div class="k-img"><img src="<%= img_font_2 %>" alt="Tovar пример 2" /></div>
          <p class="k-p">Tovar font</p>
        </div>
      </section>

      <section class="k-section" aria-label="Правила сетки">
        <h2 class="k-h2">Правила сетки</h2>

        <div class="k-quote k-narrow">
          <p>Сетке подчинены только части системы: блюда, текст и логотип</p>
        </div>

        <div class="k-section k-narrow" style="gap:16px">
          <div class="k-img">
            <img src="<%= img_grid %>" alt="Сетка" />
          </div>

          <div class="k-quote">
            <p>Колонки — 4</p>
            <p>Строчки — 6</p>
          </div>

          <div class="k-quote">
            <p>Отступы между краев и модулей — 20px</p>
          </div>

          <p class="k-p">Логотип всегда масштабируется по ширине колонки и размещается в углу</p>
        </div>

        <p class="k-p k-narrow">Ингредиенты не подчиняются сетке, продолжая идею хаоса</p>
      </section>

      <section class="k-section k-narrow" aria-label="Дополнительные примеры">
        <div class="k-img"><img src="<%= img_extra_1 %>" alt="Пример 1" /></div>
        <div class="k-img"><img src="<%= img_extra_2 %>" alt="Пример 2" /></div>
        <div class="k-img"><img src="<%= img_extra_3 %>" alt="Пример 3" /></div>
      </section>

    </div>
  </main>
</div>
