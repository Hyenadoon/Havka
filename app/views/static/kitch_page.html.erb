<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>КИТЧ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Unbounded:wght@200..900&display=swap" rel="stylesheet">
  <style>
        :root {
      --bg: #FFF5E6;
      --bg-weak: #FFFBEB;
      --ink: #1f170f;
      --ink-2: #2b241e;
      --muted: #6e6258;
      --chip: #f3ebdd;
      --accent: #ff5b3a;
      --line: #efe3d2;
    }

    html, body {
      margin: 0;
      padding: 0;
      font-family: "Inter", sans-serif;
      background: #FFF5E6;
      color: #1a120b;
      height: 100%;
    }

    body {
      display: flex;
      flex-direction: column;
    }

    .header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: var(--bg-weak);
      border-bottom: 1px solid var(--line);
    }

    .header__inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: "Unbounded", sans-serif;
      font-weight: 800;
      letter-spacing: .2px;
    }

    .nav {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .nav a {
      text-decoration: none;
      color: var(--ink-2);
      background: var(--chip);
      padding: 8px 14px;
      border-radius: 20px;
      font-weight: 600;
      font-size: .95rem;
    }


    .hero {
      flex: 1;
      display: flex;
      flex-direction: column;
      height: calc(100vh - 76px);
    }

    .container {
      flex: 1;
      max-width: 1350px;
      width: 100%;
      margin: 0 auto;
      padding: 60px 80px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-sizing: border-box;
      height: calc(100vh - 80px);
      gap: 50px;
    }

    .hero__content {
      flex: 1;
      max-width: 700px;
    }

    .hero__title {
      font-weight: 800;
      font-size: 2.8rem;
      line-height: 1.3;
      margin-bottom: 40px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #FF5D34;
      color: #fff;
      font-weight: 600;
      border-radius: 10px;
      padding: 16px 64px;
      text-decoration: none;
      margin-bottom: 20px;
      font-size: 1.1rem;
      transition: background 0.2s;
    }

    .btn:hover {
      background: #FF5D34;
    }

    .hero__timer {
      font-weight: 500;
      color: #302a25;
      margin-bottom: 50px;
      display: block;
      font-size: 1.1rem;
    }

    .hero__timer strong {
      font-weight: 800;
    }

    .hero__features-title {
      font-weight: 700;
      margin-bottom: 16px;
      font-size: 1.2rem;
    }

    .tags {
      list-style: none;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .tags li {
      background: #f3ebdd;
      border-radius: 12px;
      padding: 10px 14px;
      font-size: 1rem;
      font-weight: 500;
    }

    .hero__visual {
      flex: 1;
      min-width: 0;
      height: 100%;
      display: flex;
      align-items: stretch;
      justify-content: flex-end;
      overflow: hidden;
    }

    .visual__stage {
      position: relative;
      height: 100%;
      border-radius: 20px;
      background: transparent;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .visual__stage img {
      max-height: 100%;
      max-width: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      display: block;
      border-radius: 16px;
      height: 100%;
      object-fit: cover;
    }

    /* Мобильная версия */

    @media (max-width: 900px) {
      header {
        flex-direction: column;
        gap: 10px;
        padding: 16px 20px;
      }

      @media (max-width: 730px) {
  header {
    display: none;
  }
}

      .container {
        flex-direction: column;
        padding: 40px 20px 80px;
        display: block;
      }

      .hero__content {
        max-width: 100%;
      }

      .hero__title {
        font-size: 3rem;
      }

      .btn {
        width: 100%;
        padding: 16px 0px;
      }

      .hero__visual {
        height: auto;
        width: 100%;
        justify-content: center;
        margin-top: 40px;
      }

      .visual__stage {
        height: auto;
        width: 100%;
      }

      .visual__stage img {
        width: 100%;
        height: auto;
      }
    }
  </style>
</head>
<body>
  <header class="header">
    <div class="header__inner">
          <div class="logo">
    <svg width="139" height="23" viewBox="0 0 99 17" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12.2172 0.000208146C13.7449 0.000208146 14.4992 1.8598 13.4046 2.92716L9.23243 6.99537C8.54593 7.66476 8.54596 8.76958 9.23243 9.439L13.4046 13.5072C14.4992 14.5746 13.7449 16.4342 12.2172 16.4342H1.70227C0.762135 16.4342 0 15.6707 0 14.729V1.70534C2.58822e-05 0.763643 0.76215 0.000208146 1.70227 0.000208146H12.2172Z" fill="#292318"/>
    <path d="M25.0437 0.000208146C25.9838 0.000236267 26.746 0.763661 26.746 1.70534V14.729C26.746 15.6707 25.9838 16.4341 25.0437 16.4342H21.7466C20.4436 16.4342 19.1897 15.9353 18.2419 15.0396L12.3355 9.45752C11.6234 8.78454 11.6234 7.65004 12.3355 6.97705L18.2419 1.39499C19.1897 0.49927 20.4436 0.000208146 21.7466 0.000208146H25.0437Z" fill="#292318"/>
