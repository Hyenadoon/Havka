<%# app/views/planner/index.html.erb %>
<%# Planner (Figma node: 137:2335). One file: HTML+CSS+JS. %>

<%
  img_logo = "https://www.figma.com/api/mcp/asset/552f06ac-67f6-4d98-8d3a-641381587557"
  img_bars = "https://www.figma.com/api/mcp/asset/c1ec28f1-d038-4291-bae8-65bc7f89ca32"

  # иконки табов (можешь заменить на свои)
  img_icon_board = "https://www.figma.com/api/mcp/asset/ca1bd84d-97ee-4948-98c3-79e0991649e2"
  img_icon_main  = "https://www.figma.com/api/mcp/asset/ade429a4-8547-4f78-8ed9-5f986704846f"
  img_icon_plan  = "https://www.figma.com/api/mcp/asset/78bd6483-a7d1-4b57-8629-45bf1d06b4c0"
  img_icon_cal   = "https://www.figma.com/api/mcp/asset/04283eae-c923-4a9f-a97d-9f2e886e3bc2"
  img_recipe     = "https://www.figma.com/api/mcp/asset/ad34d8b1-8a08-424b-8400-4ec816af4271"
  img_time       = "https://www.figma.com/api/mcp/asset/5c9ab6ab-a286-4944-bb5d-8671fce50c56"
%>

<div class="k-planner">
  <style>
    :root{
      --bg-secondary:#f9f3ea;
      --bg-primary:#fff9f0;

      --text-900:#25211b;
      --text-800:#46413b;
      --text-800-61: rgba(41,35,24,0.61);

      --line-300:#e5dfd6;

      --btn-neutral-bg: rgba(41,35,24,0.05);
      --accent:#ff5d34;
      --accent-soft: rgba(255,93,52,0.12);

      --blur:21px;
      --r:16px;
      --r-md:24px;
      --r-lg:32px;

      --max:840px;
      --pad:16px;

      --font: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Inter, Arial;
    }

    *{ box-sizing:border-box; }
    html,body{ height:100%; }
    body{ margin:0; background: var(--bg-secondary); color: var(--text-900); font-family: var(--font); }
    a{ text-decoration:none; color:inherit; }

    .k-planner{ min-height:100vh; display:flex; flex-direction:column; }

    .k-nav{
      position: sticky; top:0; z-index:50;
      background: var(--bg-primary);
      border-bottom: 1px solid var(--line-300);
    }
    .k-nav__top{
      padding: 8px var(--pad);
      display:flex; align-items:center; justify-content:space-between; gap:12px;
    }
    .k-logo{ height:21px; width:153px; display:block; }
    .k-iconbtn{
      width:40px; height:40px; border-radius: var(--r);
      border:0; background: var(--btn-neutral-bg);
      backdrop-filter: blur(var(--blur));
      display:grid; place-items:center;
      cursor:pointer;
      transition: transform .12s ease, filter .12s ease;
    }
    .k-iconbtn:hover{ filter: brightness(1.02); transform: translateY(-1px); }
    .k-iconbtn:active{ transform: translateY(0) scale(.98); }
    .k-iconbtn img{ width:20px; height:20px; display:block; }

    .k-tabs-wrap{ height:64px; position:relative; background: var(--bg-primary); }
    .k-tabs{
      position:absolute; left:21px; top:50%; transform:translateY(-50%);
      display:flex; gap:8px; flex-wrap:wrap;
    }
    .k-tab{
      display:inline-flex; gap:12px;
      padding: 12px 24px;
      border-radius: var(--r);
      background: var(--btn-neutral-bg);
      backdrop-filter: blur(var(--blur));
      color: var(--text-800);
      font-weight: 700;
      letter-spacing: -0.16px;
      transition: transform .12s ease, filter .12s ease;
    }
    .k-tab:hover{ filter: brightness(1.02); transform: translateY(-1px); }
    .k-tab:active{ transform: translateY(0) scale(.99); }
    .k-tab img{ width:24px; height:24px; display:block; }

    .k-tab--active{
      background: var(--accent-soft);
      color: var(--accent);
    }

    .k-layout{
      width:100%;
      padding: 40px var(--pad) 40px;
      display:flex;
      justify-content:center;
    }
    .k-content{
      width:100%;
      max-width: var(--max);
      display:flex;
      flex-direction:column;
      gap: 40px;
    }

    .k-h1{
      margin:0;
      font-size:23px;
      line-height:1.3;
      letter-spacing:-0.576px;
      color:#514242;
      font-weight:600;
    }

    .k-cta{
      height:151px;
      border-radius: var(--r-lg);
      background: rgba(41,35,24,0.05);
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:8px;
      transition: transform .12s ease, filter .12s ease;
    }
    .k-cta:hover{ filter: brightness(1.02); transform: translateY(-1px); }
    .k-cta:active{ transform: translateY(0) scale(.99); }
    .k-cta img{ width:24px; height:24px; display:block; opacity:.95; }
    .k-cta p{
      margin:0;
      font-size:16px;
      line-height:1.5;
      letter-spacing:-0.16px;
      font-weight:700;
      color: var(--text-800);
    }

    .k-panel{
      background: var(--bg-primary);
      border-radius: 24px;
      padding: 16px 8px 8px;
      display:flex;
      flex-direction:column;
      gap:24px;
    }
    .k-panel__title{
      margin:0;
      font-size:19.2px;
      line-height:1.35;
      letter-spacing:-0.192px;
      font-weight:600;
      color: var(--text-800);
      text-align:center;
    }
    .k-panel__list{
      display:flex;
      flex-direction:column;
      gap:8px;
    }

    .k-row{
      display:flex;
      gap:8px;
      align-items:flex-start;
    }
    .k-thumb{
      width:164px; min-width:164px; height:148px;
      border-radius: 18px;
      overflow:hidden;
      background: var(--bg-primary);
      position:relative;
    }
    .k-thumb::before{ content:""; position:absolute; inset:0; background: var(--bg-primary); }
    .k-thumb img.recipe{
      position:absolute; left:50%; top:50%;
      width:95px; height:95px;
      transform: translate(-50%,-50%);
      border-radius:999px;
      object-fit:cover;
      box-shadow: inset 0 0 8px 4px rgba(255,255,255,0.95);
    }

    .k-info{ flex:1; display:flex; flex-direction:column; gap:16px; padding-top: 2px; }
    .k-titlewrap{ display:flex; flex-direction:column; gap:4px; }
    .k-title{
      margin:0; font-size:16px; line-height:1.5; letter-spacing:-0.16px;
      font-weight:700; color: var(--text-800);
    }
    .k-price{
      margin:0; font-size:16px; line-height:1.5; letter-spacing:-0.16px;
      font-weight:700; color: var(--accent);
      height:24px;
    }

    .k-tags{ display:flex; gap:4px; flex-wrap:wrap; align-items:center; }
    .k-tag{
      height:32px;
      display:inline-flex; align-items:center; justify-content:center; gap:6px;
      padding:6px 8px;
      border-radius:48px;
      background: rgba(41,35,24,0.05);
      backdrop-filter: blur(var(--blur));
      color: rgba(41,35,24,0.5);
      font-size:14.3px; letter-spacing:-0.2145px; font-weight:600;
      white-space:nowrap;
    }
    .k-tag img{ width:20px; height:20px; display:block; opacity:.9; }

    .k-section{
      display:flex;
      flex-direction:column;
      gap:16px;
    }
    .k-section__label{
      margin:0;
      font-size:16px;
      line-height:1.5;
      letter-spacing:-0.16px;
      font-weight:600;
      color: var(--text-800-61);
    }

    @media (max-width: 720px){
      .k-tabs{ left:16px; right:16px; }
      .k-tab{ padding:12px 16px; }
      .k-row{ flex-direction:column; }
      .k-thumb{ width:100%; min-width:0; height:180px; }
      .k-thumb img.recipe{ width:110px; height:110px; }
    }
  </style>

  <header class="k-nav" role="banner">
    <div class="k-nav__top">
      <img class="k-logo" src="<%= img_logo %>" alt="Солянка" />
      <button class="k-iconbtn" type="button" aria-label="Меню">
        <img src="<%= img_bars %>" alt="" />
      </button>
    </div>

    <div class="k-tabs-wrap">
      <nav class="k-tabs" aria-label="Навигация">
        <a class="k-tab" href="<%= defined?(recipes_path) ? recipes_path : '#' %>">
          <img src="<%= img_icon_board %>" alt="" />
          Подобрать рецепт
        </a>

        <a class="k-tab" href="<%= defined?(root_path) ? root_path : '#' %>">
          <img src="<%= img_icon_main %>" alt="" />
          Главная
        </a>

        <a class="k-tab k-tab--active" href="<%= defined?(planner_path) ? planner_path : '#' %>" aria-current="page">
          <img src="<%= img_icon_plan %>" alt="" />
          Планёр
        </a>
      </nav>
    </div>
  </header>

  <main class="k-layout" role="main">
    <div class="k-content">
      <h1 class="k-h1">Планируй свое питание</h1>

      <a class="k-cta" href="#">
        <img src="<%= img_icon_cal %>" alt="" />
        <p>Составить план питания</p>
      </a>

      <section class="k-panel">
        <p class="k-panel__title">Рецепты на неделю</p>

        <div class="k-panel__list">
          <% 2.times do %>
            <a class="k-row" href="#">
              <div class="k-thumb" aria-hidden="true">
                <img class="recipe" src="<%= img_recipe %>" alt="" />
              </div>
              <div class="k-info">
                <div class="k-titlewrap">
                  <p class="k-title">Суп-пюре с грибами</p>
                  <p class="k-price">~ 150р</p>
                </div>
                <div class="k-tags">
                  <span class="k-tag"><img src="<%= img_time %>" alt="" /> 15 мин</span>
                  <span class="k-tag">4 порции</span>
                </div>
              </div>
            </a>
          <% end %>
        </div>
      </section>

      <section class="k-section">
        <p class="k-section__label">Вам понравилось</p>

        <% 2.times do %>
          <a class="k-row" href="#">
            <div class="k-thumb" aria-hidden="true">
              <img class="recipe" src="<%= img_recipe %>" alt="" />
            </div>
            <div class="k-info">
              <div class="k-titlewrap">
                <p class="k-title">Суп-пюре с грибами</p>
                <p class="k-price">~ 150р</p>
              </div>
              <div class="k-tags">
                <span class="k-tag"><img src="<%= img_time %>" alt="" /> 15 мин</span>
                <span class="k-tag">4 порции</span>
              </div>
            </div>
          </a>
        <% end %>
      </section>
    </div>
  </main>
</div>
